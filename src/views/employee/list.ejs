<div class="list-page">
  <div class="page-header">
    <h2>All Employees</h2>
    <div class="button-box">
      <form action="<%= baseURL %>demo/reset" method="post">
        <button type="submit" class="secondary-button">Reset Demo</button>
      </form>
      <a href="<%= baseURL %>employees/new" class="link-button-style main-button">New Employee</a>
    </div>
  </div>


  <div>
    <% if (allEmployees) { %>
      <ul>  
        <% for (const employee of allEmployees) { %>
          <li>
            <a href="<%= baseURL %>employees/<%= employee.id %>">
              <span class="employee-name"><%= employee.name %></span>
            </a>
            <span><%= employee.start %> - <%= employee.end %></span>
            <div>
              <span> Vacation: </span>
              <span><%= employee.vacation %> days</span>
            </div>
          </li>
          <hr>
        <% } %>
      </ul>
    <% } else { %>
      <p>No employees available.</p>
    <% } %>
  </div>
</div>