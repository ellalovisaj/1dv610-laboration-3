
<div class="employees-header">
  <h2>All Employees</h2>
  <div id="employees-buttons">
    <form action="<%= baseURL %>demo/reset" method="post">
    <button type="submit" id="employees-reset-button" class="secondary-button">Reset Demo</button>
    </form>
    <a href="<%= baseURL %>employees/new" id="employees-new-link" class="link-button-style main-button">New Employee</a>
  </div>
</div>


<div>
  <% if (allEmployees) { %>
    <ul>  
      <% for (let employee of allEmployees) { %>
        <li id="employee-info">
          <a href="<%= baseURL %>employees/<%= employee.getId() %>">Link</a>
          <p id="employee-name"><%= employee.getName() %></p>
          <p id="employee-id"> ID: <%= employee.getId() %></p>
          <p id="employee-working-hours">
            Working hours: <%= employee.getWorkingHours().workdayStart %> - <%= employee.getWorkingHours().workdayEnd %>
          </p>
          <p id="employee-vacation-days"> Vacation days: <%= employee.getVacationDaysPerYear() %></p>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <p>No employees available.</p>
  <% } %>
</div>
