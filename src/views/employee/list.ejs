
<div class="employees-header">
  <h2>All Employees</h2>
  <div id="employees-buttons">
    <form action="<%= baseURL %>demo/reset" method="post">
    <button type="submit" id="employees-reset-button" class="secondary-button">Reset Demo</button>
    </form>
    <a href="<%= baseURL %>employees/new" id="employees-new-link" class="link-button-style main-button">New Employee</a>
  </div>
</div>


<div>
  <% if (allEmployees) { %>
    <ul>  
      <% for (let employee of allEmployees) { %>
        <li class="employee-info">
          <a href="<%= baseURL %>employees/<%= employee.id %>">Link</a>
          <p class="employee-name"><%= employee.name %></p>
          <p class="employee-id"> ID: <%= employee.id %></p>
          <p class="employee-working-hours">
            Working hours: <%= employee.start %> - <%= employee.end %>
          </p>
          <p class="employee-vacation-days"> Vacation days: <%= employee.vacation %></p>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <p>No employees available.</p>
  <% } %>
</div>
