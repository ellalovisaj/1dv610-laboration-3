<div class="details-page">
  <% if (employee) { %>

    <div class="page-header">
      <h2>Employee Profile</h2>
      <a href="<%= baseURL %>employees/<%= employee.id %>/edit" id="profile-edit-link" class="link-button-style secondary-button">Edit Employee</a>
    </div>

    <h3 class="name-header">
      <%= employee.name %>
    </h3>


    <p class="details-id"> ID: <%= employee.id %><p>
      
    <div class="employee-details">
      <span class="details-title">Working hours:</span>
      <span class="details-data">
        <%= employee.start %> - <%= employee.end %>
      </span>
      <span class="details-title"> Vacation days:</span>
      <span class="details-data">
        <%= employee.vacation %>
      </span>
    </div>

    <hr>

    <%- include('../booking/list', { employee, bookings }) %>

  <% } else { %>
    <p>No employee.</p>
  <% } %>
</div>