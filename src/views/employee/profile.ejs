<div class="details-page">
  <% if (employee) { %>

    <div class="page-header">
      <h2>
        <%= employee.name %>
      </h2>
      <div class="button-box">
        <a href="" class="link-button-style secondary-button">Other Button</a>
        <a href="<%= baseURL %>employees/<%= employee.id %>/edit" class="link-button-style secondary-button">Edit Employee</a>
      </div>
      
    </div>
      
    <div class="details">
      <span>Working hours:</span>
      <span><%= employee.start %> - <%= employee.end %></span>
      <span> Vacation days:</span>
      <span><%= employee.vacation %></span>
    </div>

    <%- include('../booking/list', { employee, bookings }) %>

  <% } else { %>
    <p>No employee.</p>
  <% } %>
</div>