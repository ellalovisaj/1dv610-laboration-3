<h2>Booking Details</h2>

<div>
  <% if (booking) { %>
    <h3 class="name-header">
      <%= booking.employeeName %>
    </h3>
    
    <div class="details-id">
      <span> Booking ID: <%= booking.id %></span>
    </div>

    <div class="booking-details">
      <span id="booking-employee-name"> Employee Name: </span>
      <span> <%= booking.employeeName %></span>
      <span id="booking-customer-name"> Customer Name: </span>
      <span><%= booking.customerName %></span>
      <span id="booking-date"> Date: </span>
      <span><%= booking.date %></span>
      <span id="booking-times"> Time: </span>
      <span><%= booking.start %> - <%= booking.end %></span>
      <span id="booking-duration"> Time: </span>
      <span><%= booking.duration %> minutes</span>
    </div>

    <div class="form-row">
      <a href="<%= baseURL %>employees/<%= booking.employeeId %>" id="booking-back-link" class="link-button-style secondary-button">Back</a>
      <a href="<%= baseURL %>employees/<%= booking.employeeId %>/booking/<%= booking.id %>/edit" id="booking-edit-link" class="link-button-style main-button">Edit</a>
    </div>

  <% } else { %>
    <p>No employee.</p>
  <% } %>
</div>