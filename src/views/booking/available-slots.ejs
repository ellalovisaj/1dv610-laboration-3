<div class="slot-page">

  <div class="page-header">
    <a href="<%= previousDayURL %>" class="link-button-style secondary-button">←</a>
    <h3><%= date %></h3>
    <a href="<%= nextDayURL %>" class="link-button-style secondary-button">→</a>
  </div>


  <% if (slots.length > 0) { %>
    <fieldset>
      <% for (const slot of slots) { %>
        <hr>
        <label class="radio-button-style main-button">
          <input type="radio" name="start" value="<%= slot.start %>" class="visually-hidden">
          <%= slot.start %> - <%= slot.end %>
        </label>
      <% } %>
    </fieldset>
  <% } else { %>
    <p>No available times this day</p>
  <% } %>
</div>