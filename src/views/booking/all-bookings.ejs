
<div class="list-page">
  <div class="page-header">
    <h2>All Bookings</h2>
  </div> 

  <% if (bookings.length > 0) { %>
    <ul>  
      <% for (const booking of bookings) { %>
        <hr>
        <li>
          <a href="<%= baseURL %>employees/<%= booking.employeeId %>/booking/<%= booking.id %>">
            <span><%= booking.employeeName %></span>
            <span><%= booking.customerName %></span>
            <span> Date: <%= booking.date %></span>
            <span>Time: <%= booking.start %> - <%= booking.end %></span>
          </a>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <p>No Bookings</p>
  <% } %>
</div>
