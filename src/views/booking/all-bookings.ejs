
<div class="list-page">
  <div class="page-header">
    <h2>All Bookings</h2>
  </div> 

  <% if (bookings.length > 0) { %>
    <ul class="all-bookings-list">
      <li class="all-bookings list-title">
        <span>Employee</span>
        <span>Customer</span>
        <span>Date</span>
        <span>Time</span>
      </li>
      <% for (const booking of bookings) { %>
        <hr>
        <li>
          <a href="<%= baseURL %>employees/<%= booking.employeeId %>/booking/<%= booking.id %>">
            <span><%= booking.employeeName %></span>
            <span><%= booking.customerName %></span>
            <span><%= booking.date %></span>
            <span><%= booking.start %> - <%= booking.end %></span>
          </a>
        </li>
      <% } %>
    </ul>
  <% } else { %>
    <p>No Bookings</p>
  <% } %>
</div>
