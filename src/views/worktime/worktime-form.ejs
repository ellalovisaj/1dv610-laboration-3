<h2>Select month or specific dates</h2>

<form action="<% process.env.BASE_URL %>worktime" method="post" id="form">
  <input type="month" name="month" placeholder="Month">
  
  <label for="month">Select start date</label>
  <input type="date" id="date" name="start-date">
 
  <label for="month">Select end date</label>
  <input type="date" id="date2" name="end-date">

  <label for="percentage">Percentage of full time</label>
  <input type="number" name="percentage" max="100" min="0" step="5" value="100" required>

  <label for="salary">Salary per hour (optional)</label>
  <input type="number" name="salary" min="0" step=".01" >

  <button type="submit">OK</button>
</form>