<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>1DV610 - Laboration 3</title>
  <link rel="stylesheet" href="<%= baseURL %>css/styles.css" />
</head>

<body>
  <header>
    <a href="<%= baseURL %>employees" class="link-button-style"> Home </a>
    <a href="<%= baseURL %>booking/all" class="link-button-style"> All bookings </a>
  </header>

   <% if (locals.flash) { %>
      <div class="flash flash-<%= flash.type %>">
        <p>Flash</p>
        <p><%= flash.message %></p>
        <p><%= flash.type %></p>
      </div>
    <% } %>
  <main>
    <% if (locals.backURL) { %>
      <a href="<%= backURL %>" class="link-button-style secondary-button back-link">Back</a>
    <% } %>

    

    <div class="page-content">
      <%- body %>
    </div>
  </main>

  <footer>
    <p>1DV610 - Laboration 3</p>
    <p>Ella-Lovisa Johansson</p>
  </footer>

</body>

</html>