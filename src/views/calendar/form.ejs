<form action="<% process.env.BASE_URL %>test-form" method="post" id="form">
  <input type="text" name="test" placeholder="Test" required>
  <input type="date" id="date" name="date">
</form>

<% if (date) { %>
  <p> Date is <%= date %>.</p>
<% } %>

<% if (holiday !== undefined) { %>
  <p> Is a holiday? <%= holiday %>.</p>
<% } %>
